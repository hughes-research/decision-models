{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tetris",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "or-solver",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "or-solver",
        "uvicorn",
        "orsolver.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8100"
      ],
      "port": 8100
    }
  ]
}
